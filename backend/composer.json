{
  "name": "enterprise-erp-cloud/api",
  "type": "project",
  "require": {
    "php": "^8.4.1",
    "ext-bcmath": "*",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": { "pestphp/pest": "^4.0", "phpunit/phpunit": "^12.0",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.24" },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": { "test": "php artisan test", "lint": "find app database routes tests -name '*.php' -print0 | xargs -0 -n1 php -l" },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
